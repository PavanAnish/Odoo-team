<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend account.move form view with subscription details, statusbar, lifecycle buttons, history tab, and payments -->
    <record id="view_move_form_inherit_subscription" model="ir.ui.view">
        <field name="name">account.move.form.inherit.subscription</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Header buttons for invoice lifecycle -->
            <xpath expr="//header" position="inside">
                <button name="action_confirm"
                        string="Confirm Invoice"
                        type="object"
                        class="oe_highlight"
                        invisible="invoice_status != 'draft'"/>
                <button name="action_mark_paid"
                        string="Record Payment"
                        type="object"
                        class="oe_highlight"
                        invisible="invoice_status != 'confirmed'"/>
                <button name="action_send_invoice"
                        string="Send by Email"
                        type="object"
                        invisible="invoice_status not in ('confirmed', 'paid')"/>
                <button name="action_download_invoice"
                        string="Download PDF"
                        type="object"
                        invisible="invoice_status == 'cancel'"/>
                <button name="action_print_invoice"
                        string="Print"
                        type="object"
                        invisible="invoice_status == 'cancel'"/>
                <button name="action_cancel"
                        string="Cancel Invoice"
                        type="object"
                        invisible="invoice_status not in ('draft', 'confirmed')"/>
                <field name="invoice_status"
                       widget="statusbar"
                       statusbar_visible="draft,confirmed,paid"/>
            </xpath>

            <!-- Stat button for Payments -->
            <xpath expr="//sheet/div[@class='oe_button_box']" position="inside">
                <button name="action_view_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money">
                    <field name="payment_count" widget="statinfo" string="Payments"/>
                </button>
            </xpath>

            <!-- Subscription Reference and Payment Balances -->
            <xpath expr="//field[@name='ref']" position="after">
                <field name="subscription_id" readonly="1" invisible="not subscription_id"/>
                <field name="subscription_billing_date" readonly="1" invisible="not subscription_id"/>
                <field name="amount_paid" readonly="1"/>
                <field name="amount_residual" readonly="1"/>
                <field name="invoice_sent" readonly="1" invisible="not invoice_sent"/>
                <field name="invoice_sent_date" readonly="1" invisible="not invoice_sent"/>
            </xpath>

            <!-- Notebook Pages: Payments & Lifecycle History -->
            <xpath expr="//notebook" position="inside">
                <page string="Recorded Payments" name="recorded_payments">
                    <field name="payment_ids" readonly="1">
                        <tree string="Payments" default_order="payment_date desc" create="0" delete="0" edit="0">
                            <field name="name"/>
                            <field name="payment_date"/>
                            <field name="payment_method"/>
                            <field name="amount"/>
                            <field name="payment_reference"/>
                            <field name="notes"/>
                            <field name="user_id" string="Recorded By"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </page>
                <page string="Lifecycle History" name="lifecycle_history">
                    <field name="history_ids" readonly="1">
                        <tree string="Status History" default_order="timestamp desc" create="0" delete="0" edit="0">
                            <field name="timestamp"/>
                            <field name="user_name" string="Actor"/>
                            <field name="action"/>
                            <field name="previous_status" widget="badge"/>
                            <field name="current_status" widget="badge"/>
                            <field name="details"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Payment Views for AccountPayment -->
    <record id="view_account_payment_tree_subscription" model="ir.ui.view">
        <field name="name">account.payment.tree.subscription</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <tree string="Payments" default_order="payment_date desc">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="payment_date"/>
                <field name="payment_method"/>
                <field name="amount"/>
                <field name="payment_reference"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_account_payment_form_subscription" model="ir.ui.view">
        <field name="name">account.payment.form.subscription</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <form string="Payment Details">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Transaction Information">
                            <field name="invoice_id"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_date"/>
                        </group>
                        <group string="Settlement &amp; Audit">
                            <field name="payment_method"/>
                            <field name="payment_reference"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Notes" name="payment_notes">
                            <field name="notes" placeholder="Internal memo or receipt details..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Extend subscription form view with invoice generation button, stat button, and line discount/taxes -->
    <record id="view_subscription_form_inherit_billing" model="ir.ui.view">
        <field name="name">subscription.subscription.form.inherit.billing</field>
        <field name="model">subscription.subscription</field>
        <field name="inherit_id" ref="subscription_management.view_subscription_subscription_form"/>
        <field name="arch" type="xml">
            <!-- Header button: manual invoice generation for active contracts -->
            <xpath expr="//header" position="inside">
                <button name="action_generate_invoice"
                        string="Generate Invoice"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'active'"/>
            </xpath>

            <!-- Stat button: invoice counter and drilldown -->
            <xpath expr="//sheet/div[@class='oe_title']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_invoices"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o">
                        <field name="invoice_count" widget="statinfo" string="Invoices"/>
                    </button>
                </div>
            </xpath>

            <!-- Line discount and taxes in subscription lines tree -->
            <xpath expr="//field[@name='line_ids']/tree/field[@name='price_unit']" position="after">
                <field name="discount" optional="show"/>
                <field name="tax_ids" widget="many2many_tags" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Subscription Invoices Action Window & Menu -->
    <record id="action_subscription_invoices" model="ir.actions.act_window">
        <field name="name">Subscription Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('subscription_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'default_invoice_status': 'draft'}</field>
    </record>

    <menuitem id="menu_subscription_invoices"
              name="Invoices"
              parent="subscription_base.menu_subscription_billing_menu"
              action="action_subscription_invoices"
              sequence="10"/>

    <!-- Payments Action Window & Menu -->
    <record id="action_subscription_payments" model="ir.actions.act_window">
        <field name="name">Customer Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No payments recorded yet.</p>
        </field>
    </record>

    <menuitem id="menu_subscription_payments"
              name="Payments"
              parent="subscription_base.menu_subscription_billing_menu"
              action="action_subscription_payments"
              sequence="20"/>
</odoo>
