<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================================================================== -->
    <!-- ir.cron: Daily Quotation Expiration Status Refresh                    -->
    <!-- ===================================================================== -->
    <record id="cron_subscription_check_expiration" model="ir.cron">
        <field name="name">Subscription: Check Quotation Expiration Status</field>
        <field name="model_id" ref="model_subscription_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_expiration_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="priority">100</field>
    </record>
</odoo>
