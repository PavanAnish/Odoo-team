<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Quotations and Subscriptions -->
        <record id="seq_subscription_quotation" model="ir.sequence">
            <field name="name">Subscription Quotation Sequence</field>
            <field name="code">subscription.subscription</field>
            <field name="prefix">QT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
