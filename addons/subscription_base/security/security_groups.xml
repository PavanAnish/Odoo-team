<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Root Module Category for Subscription Management System -->
        <record id="module_category_subscription_management" model="ir.module.category">
            <field name="name">Subscriptions</field>
            <field name="description">Access management for Subscription System</field>
            <field name="sequence">20</field>
        </record>

        <!-- Base User Group (Staff) -->
        <record id="group_subscription_user" model="res.groups">
            <field name="name">User / Internal Staff</field>
            <field name="category_id" ref="module_category_subscription_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Internal staff responsible for customer inquiries, quotations, and monitoring subscriptions.</field>
        </record>

        <!-- Administrator Group -->
        <record id="group_subscription_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_subscription_management"/>
            <field name="implied_ids" eval="[(4, ref('group_subscription_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">System administrator with full access to configuration, billing, and reports.</field>
        </record>
    </data>
</odoo>
