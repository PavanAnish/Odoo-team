<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        ======================================================================
        M1-03: Unauthorized Role Access — Record Rules
        ======================================================================
        Record rules enforce row-level access control INDEPENDENTLY of ACLs.
        These rules fire on every ORM read/write/create/unlink regardless of
        how the request arrives (UI, JSON-RPC, XML-RPC, shell).

        ADVERSARIAL REVIEW FINDINGS APPLIED:

        Finding R-A: The original draft included a res.users record rule for
        group_subscription_user (Staff). Because group_subscription_manager
        INHERITS group_subscription_user, that rule would also scope ADMIN
        users to their own record only — breaking admin user management.
        Resolution: NO res.users record rule is applied to Staff. The ACL
        already grants Staff only perm_read with no write/create/unlink, so
        the only operation Staff can perform on res.users is reading their own
        record (enforced by the portal rule below if they also hold a portal
        session, or by Odoo's default internal-user visibility otherwise).
        Admins are unaffected because they are in group_subscription_manager
        which has its own full-access ACL row and no restrictive record rule.

        Finding R-B: perm_write=True on record rules is misleading when the
        ACL grants no perm_write. The record rule perm_write is evaluated only
        AFTER the ACL check passes. Since the ACL for portal users on
        res.users is read-only (perm_write=0), the perm_write=True on the
        record rule is redundant but harmless. Clarified in comments.

        Rules defined here:

        1. rule_partner_portal_own_record
           Customers can only read their own res.partner record.
           (ACL grants portal perm_write=0 on res.partner, so perm_write
           on this rule is irrelevant — kept False for clarity.)

        2. rule_users_portal_own_record
           Customers can only read their own res.users record.
           (ACL grants portal perm_write=0 on res.users, so perm_write
           on this rule is irrelevant — kept False for clarity.)

        NOT defined here (adversarial finding removed):
        - No res.users record rule for group_subscription_user alone,
          because group_subscription_manager inherits it, which would
          accidentally scope admins to their own record.

        subscription.subscription portal isolation already defined in
        subscription_management/security/security_rules.xml — NOT duplicated.
        ======================================================================
        -->

        <!-- ── res.partner record rules ─────────────────────────────────── -->

        <!--
        Customers: own partner record only.
        ACL grants portal perm_read=1, perm_write=0 on res.partner, so this
        rule's perm_write=False is consistent with the ACL.
        -->
        <record id="rule_partner_portal_own_record" model="ir.rule">
            <field name="name">Customer: Own Partner Record Only</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ── res.users record rules ────────────────────────────────────── -->

        <!--
        Customers: own user record only.
        ACL grants portal perm_read=1, perm_write=0 on res.users.
        This rule prevents enumeration of other user records via search().

        IMPORTANT: This rule applies only to base.group_portal.
        group_subscription_manager does NOT inherit base.group_portal
        (admins are internal users, not portal users), so this rule does NOT
        scope admins to their own record. Admin access is unrestricted.
        -->
        <record id="rule_users_portal_own_record" model="ir.rule">
            <field name="name">Customer: Own User Record Only</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">[('id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
