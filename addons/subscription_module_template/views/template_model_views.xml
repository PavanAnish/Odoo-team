<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_subscription_template_item_tree" model="ir.ui.view">
        <field name="name">subscription.template.item.tree</field>
        <field name="model">subscription.template.item</field>
        <field name="arch" type="xml">
            <tree string="Template Items" decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_subscription_template_item_form" model="ir.ui.view">
        <field name="name">subscription.template.item.form</field>
        <field name="model">subscription.template.item</field>
        <field name="arch" type="xml">
            <form string="Template Item">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('draft', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Monthly Standard Template"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description_page">
                            <field name="description" placeholder="Add operational notes or guidance here..."/>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter Integration -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_subscription_template_item_search" model="ir.ui.view">
        <field name="name">subscription.template.item.search</field>
        <field name="model">subscription.template.item</field>
        <field name="arch" type="xml">
            <search string="Search Template Items">
                <field name="name" string="Name or Code" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_subscription_template_item" model="ir.actions.act_window">
        <field name="name">Template Items</field>
        <field name="res_model">subscription.template.item</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_subscription_template_item_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first template item!
            </p>
            <p>
                Use this screen to test and demonstrate standard Odoo CRUD operations.
            </p>
        </field>
    </record>
</odoo>
