<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_template_wizard_form" model="ir.ui.view">
        <field name="name">subscription.template.wizard.form</field>
        <field name="model">subscription.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Update Items">
                <group>
                    <field name="reason" placeholder="e.g. Mass review for Q3"/>
                    <field name="item_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_subscription_template_wizard" model="ir.actions.act_window">
        <field name="name">Batch Update</field>
        <field name="res_model">subscription.template.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_subscription_template_item"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
