<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Module Security Category -->
        <record id="module_category_subscription_template" model="ir.module.category">
            <field name="name">Subscription Template</field>
            <field name="description">Access rights category for Subscription Template</field>
            <field name="sequence">50</field>
        </record>

        <!-- User Group: Standard User -->
        <record id="group_subscription_template_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_subscription_template"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Standard user with read and write access to own template records.</field>
        </record>

        <!-- User Group: Manager / Administrator -->
        <record id="group_subscription_template_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_subscription_template"/>
            <field name="implied_ids" eval="[(4, ref('group_subscription_template_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Manager with full administrative and deletion access.</field>
        </record>

        <!-- Multi-Company Record Rule -->
        <record id="rule_subscription_template_item_multicompany" model="ir.rule">
            <field name="name">Subscription Template Item Multi-Company Rule</field>
            <field name="model_id" ref="model_subscription_template_item"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
