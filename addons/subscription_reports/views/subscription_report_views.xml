<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pivot View -->
    <record id="view_subscription_report_pivot" model="ir.ui.view">
        <field name="name">subscription.report.pivot</field>
        <field name="model">subscription.report</field>
        <field name="arch" type="xml">
            <pivot string="Subscription Analysis" sample="1">
                <field name="plan_id" type="row"/>
                <field name="date_start" interval="month" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_subscription_report_graph" model="ir.ui.view">
        <field name="name">subscription.report.graph</field>
        <field name="model">subscription.report</field>
        <field name="arch" type="xml">
            <graph string="Subscription Breakdown" type="bar" sample="1">
                <field name="plan_id"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_subscription_report_search" model="ir.ui.view">
        <field name="name">subscription.report.search</field>
        <field name="model">subscription.report</field>
        <field name="arch" type="xml">
            <search string="Search Analysis">
                <field name="partner_id"/>
                <field name="plan_id"/>
                <filter string="Active Only" name="filter_active" domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Start Month" name="group_month" context="{'group_by': 'date_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_subscription_report_all" model="ir.actions.act_window">
        <field name="name">Subscription Analysis</field>
        <field name="res_model">subscription.report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_subscription_report_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <menuitem id="menu_subscription_report_analysis"
              name="Subscription Analysis"
              parent="subscription_base.menu_subscription_reporting_menu"
              action="action_subscription_report_all"
              sequence="10"/>
</odoo>
