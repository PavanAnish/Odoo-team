<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Plan Views -->
    <record id="view_subscription_plan_tree" model="ir.ui.view">
        <field name="name">subscription.plan.tree</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <tree string="Subscription Plans">
                <field name="code"/>
                <field name="name"/>
                <field name="billing_interval"/>
                <field name="billing_period"/>
                <field name="trial_period_days"/>
                <field name="min_quantity"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Monthly Standard"/>
                        </h1>
                    </div>
                    <group>
                        <group name="plan_details">
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                            <label for="billing_interval" string="Billing Cycle"/>
                            <div class="o_row">
                                <field name="billing_interval" class="oe_inline"/>
                                <field name="billing_period" class="oe_inline"/>
                            </div>
                            <field name="min_quantity"/>
                        </group>
                        <group name="plan_rules">
                            <field name="trial_period_days"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Renewal &amp; Expiration Settings" name="renewal_settings">
                        <group>
                            <field name="allow_renewal"/>
                            <field name="auto_renewal" invisible="not allow_renewal"/>
                        </group>
                        <group>
                            <field name="auto_closure"/>
                        </group>
                    </group>
                    <group string="Pause &amp; Closure Settings" name="pause_settings">
                        <group>
                            <field name="allow_pause"/>
                            <field name="allow_early_closure"/>
                        </group>
                        <group>
                            <field name="pause_billing_policy" invisible="not allow_pause"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Internal Notes" name="notes_page">
                            <field name="notes" placeholder="Plan terms, operational restrictions, and SLA details..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_subscription_plans" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your first subscription billing plan!
            </p>
        </field>
    </record>

    <!-- Menuitem under Catalog -->
    <menuitem id="menu_subscription_plans"
              name="Plans"
              parent="subscription_base.menu_subscription_catalog_menu"
              action="action_subscription_plans"
              sequence="10"/>
</odoo>
